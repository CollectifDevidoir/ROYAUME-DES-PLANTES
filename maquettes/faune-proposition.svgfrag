 </g>
 <!-- 8. Toile d'araignée accrochée entre deux frondes -->
 <g transform="translate(1110 716)" fill="none" stroke="var(--t1)" stroke-width=".5" opacity=".22">
  <path d="M0 0L-16-12M0 0L4-18M0 0L18-8M0 0L14 12M0 0L-14 10"/>
