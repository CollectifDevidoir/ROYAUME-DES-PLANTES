  <circle cx="11.4" cy="-11.6" r=".8" fill="var(--bg2)" opacity=".8"/>
 </g>
 <!-- 6. Mésange posée sur une petite branche morte -->
 <g transform="translate(896 432)">
  <path d="M-4 1.6C6 0 16-1.6 26-3.4" fill="none" stroke="var(--t1)" stroke-width="1.6" stroke-linecap="round" opacity=".2"/>
  <path d="M8-1.2C8-6.2 11.6-9.4 15.6-9.4C18.4-9.4 20.2-7.6 20.8-5.8L23.6-5.6 20.8-4.2C20.4-1.4 18.4.8 15 1.2L9.2 1.8 3.4 4.6 6.4 1C7.4.4 8 -.2 8-1.2Z" fill="var(--t1)" opacity=".34"/>
  <path d="M14 1.4 13.4 3.4M16.4 1.2 16.6 3" stroke="var(--t1)" stroke-width=".6" opacity=".34"/>
 </g>
 <!-- 7. Papillon dans un rayon de lumière -->
 <g transform="translate(520 360) rotate(-12)" fill="#fff" opacity=".55">
  <path d="M0 0C-3-6-9-8-10-4C-11 0-6 2 0 0Z"/><path d="M0 0C3-6 9-8 10-4C11 0 6 2 0 0Z"/>
