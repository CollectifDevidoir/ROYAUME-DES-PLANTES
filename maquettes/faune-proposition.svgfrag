  <path d="M-42 8C-40 6.4-37.6 6.2-35.6 7-37.6 9.2-40 9.4-42 8Z" fill="var(--bg2)" opacity=".55"/>
 </g>
 <!-- 3. Coccinelle qui remonte le rachis de la fronde -->
 <g transform="translate(80.5 668) rotate(-34)">
  <ellipse cx="0" cy="0" rx="4" ry="3.1" fill="#a8574a" opacity=".8"/>
  <path d="M3.4-2A3 3 0 0 1 3.4 2L5.3 1.3A1.8 1.8 0 0 0 5.3-1.3Z" fill="var(--t1)" opacity=".75"/>
