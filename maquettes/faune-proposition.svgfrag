  <path d="M-.9-1.2L0 1.4 .9-1.2Z" fill="var(--bg2)" opacity=".45"/>
  <path d="M-4 6Q0 8 4 6M-4.5 10Q0 12 4.5 10" fill="none" stroke="var(--bg2)" stroke-width=".7" opacity=".25"/>
 </g>
 <!-- 2. Renard qui guette derrière le tronc, la queue posée de l'autre côté -->
 <g transform="translate(629 787)">
  <path d="M0 0C3-5 8-8 13-9L15-17 18-9.5 20-15.5 21.5-8.6C25-7.6 28-5.6 33-4.4C30-1.4 26 .4 21 .8C14 1.6 7 1.4 0 1.2Z" fill="#7d6247" opacity=".3"/>
