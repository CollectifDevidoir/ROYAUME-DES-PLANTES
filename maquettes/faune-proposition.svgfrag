<g class="faune">
 <!-- 1. Chouette hulotte endormie dans une loge du tronc -->
 <g transform="translate(979 318)">
  <path d="M-12 19C-15 6-14-9-7-16C-1-21 7-19 11-13C15-5 14 8 11 19Z" fill="var(--t1)" opacity=".42"/>
  <path d="M-8 19C-10 10-9 1-7-4C-5-9-2-11 1-11C4-11 7-8 8-4C10 1 10 10 8 19Z" fill="var(--t1)" opacity=".42"/>
