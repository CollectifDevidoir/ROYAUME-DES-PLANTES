  <circle cx="-1.6" cy="-1.2" r=".65" fill="var(--t1)" opacity=".6"/><circle cx="1.5" cy="1.3" r=".65" fill="var(--t1)" opacity=".6"/>
 </g>
 <!-- 4. Escargot au pied d'un tronc -->
 <g transform="translate(352 795)" fill="var(--t1)" opacity=".3">
  <path d="M-10 0C-10-7-4-11 2-10C7-9 9-4 7 0Z"/><path d="M-13 0H11C13 0 15-2 15-4L17-9 16-3C16 0 14 1 11 1H-13Z"/>
  <path d="M-1-6A3 3 0 1 1 2-3" fill="none" stroke="var(--bg2)" stroke-width="1" opacity=".55"/>
 </g>
 <!-- 5. Écureuil assis au pied d'un tronc, queue en panache -->
 <g transform="translate(902 797)" fill="var(--t1)" opacity=".36">
  <path d="M-3 0C-14-1-19-13-15-23C-12-31-3-34 2-28C-4-27-8-22-7-15C-6-9-2-5 2-3Z"/>
